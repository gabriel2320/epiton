EPITON_UPSTREAM=http://127.0.0.1:8000
EPITON_GATEWAY_BIND=0.0.0.0:8080
# Lab/default: false. Production: enable only after auditing ir.model.access.
EPITON_STRICT_ACL=false
# Empty is the production same-origin default. List explicit development origins only.
EPITON_CORS_ORIGINS=
EPITON_MAX_BODY_BYTES=16777216
# Caps buffered upstream payloads (default 64 MiB, including report responses).
EPITON_MAX_RESPONSE_BYTES=67108864
EPITON_LOGIN_LIMIT_PER_MINUTE=20
EPITON_UPSTREAM_TIMEOUT_SECS=120
# Enable only when every request reaches the gateway through a trusted reverse proxy.
EPITON_TRUST_PROXY=false
