{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/target/**",
      "apps/desktop/src-tauri/gen/**",
      "apps/mobile/android/app/build/**",
      "apps/mobile/android/app/src/main/assets/**",
      "apps/mobile/android/capacitor-cordova-android-plugins/**",
      "**/.turbo/**",
      "**/.next/**",
      "**/dev-dist/**",
      "**/www/**",
      "**/test-results/**",
      "tests/compat/receipts/**",
      "**/playwright-report/**"
    ]
  }
}
