{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "e2e/**", "playwright*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/styles/app.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/target",
      "!**/apps/desktop/src-tauri/gen",
      "!**/apps/mobile/android/app/build",
      "!**/apps/mobile/android/build",
      "!**/apps/mobile/android/app/src/main/assets",
      "!**/apps/mobile/android/capacitor-cordova-android-plugins",
      "!**/.turbo",
      "!**/.next",
      "!**/dev-dist",
      "!**/www",
      "!**/test-results",
      "!**/tests/compat/receipts",
      "!**/playwright-report"
    ]
  }
}
