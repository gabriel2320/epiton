{
  "name": "epiton",
  "private": true,
  "version": "0.1.0",
  "description": "Epiton — modern multiplatform Tryton-compatible client platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@epiton/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "lab:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "lab:down": "docker compose -f docker/docker-compose.yml down",
    "lab:smoke": "bash docker/smoke-rpc.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
