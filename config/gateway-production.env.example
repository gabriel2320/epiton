# Production baseline for an edge proxy running on the same host.
# This file contains no secrets. Review every value before deployment.
EPITON_GATEWAY_BIND=127.0.0.1:8080
EPITON_UPSTREAM=http://trytond.internal:8000
EPITON_CORS_ORIGINS=
EPITON_TRUST_PROXY=true
EPITON_STRICT_ACL=true
EPITON_MAX_BODY_BYTES=16777216
EPITON_MAX_RESPONSE_BYTES=67108864
EPITON_LOGIN_LIMIT_PER_MINUTE=20
EPITON_UPSTREAM_TIMEOUT_SECS=120
